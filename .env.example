# SIH26189 — Environment Configuration Example (SEC-001)
# Copy this file to .env and fill in environment-specific secrets.
# NEVER commit real credentials to Git.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database (Authoritative System of Record)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=criminal_network_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/criminal_network_db

# Neo4j Graph Database (Analytical Projection)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password

# Redis / Background Worker
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT & Authentication
JWT_SECRET=change_this_to_a_secure_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / Extraction Gateway (Optional / Internal Provider Abstraction)
AI_GATEWAY_URL=http://localhost:8080/v1
AI_MODEL_NAME=gemini-2.5-flash
AI_API_KEY=your_optional_gateway_or_provider_api_key
